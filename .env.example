# HJ GROUPS server-side shortener configuration
# Keep real values only in Voroa/server environment variables.
# Never prefix these with VITE_.

AROLINKS_API_TOKEN=
EARN4LINK_API_TOKEN=
HJ_PUBLIC_BASE_URL=https://your-hj-groups-domain.example
UNLOCK_TOKEN_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Public Telegram Streaming runtime.
# The project already has an existing Render deployment with the verified
# Telegram session environment. Do not pin this to a deployment-specific Vercel URL.
VITE_STREAMING_SERVER_URL=https://hj-telegram-streaming.onrender.com
