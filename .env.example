# HJ GROUPS server-side shortener configuration
# Keep real values only in Voroa/server environment variables.
# Never prefix these with VITE_.

AROLINKS_API_TOKEN=
EARN4LINK_API_TOKEN=
HJ_PUBLIC_BASE_URL=https://your-hj-groups-domain.example
UNLOCK_TOKEN_SECRET=
SUPABASE_SERVICE_ROLE_KEY=


# Public Telegram Streaming project URL. Prefer the stable project URL,
# not an immutable deployment-specific *.vercel.app hostname.
VITE_STREAMING_SERVER_URL=https://hj-telegram-streaming.vercel.app
