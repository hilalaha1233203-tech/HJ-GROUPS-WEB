# HJ GROUPS server-side shortener configuration
# Keep real values only in Voroa/server environment variables.
# Never prefix these with VITE_.

AROLINKS_API_TOKEN=
EARN4LINK_API_TOKEN=
HJ_PUBLIC_BASE_URL=https://your-hj-groups-domain.example
UNLOCK_TOKEN_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Public Telegram Streaming runtime.
# The active Worker deployment is the Cloudflare Worker; legacy Render/Vercel
# streaming endpoints must not be used as the production default.
VITE_STREAMING_SERVER_URL=https://hj-telegram-streaming.hilalaha1233203.workers.dev

# Server-only token with GitHub Actions write permission for workflow_dispatch. Never use a VITE_ prefix.
HJ_GITHUB_ACTIONS_TOKEN=
